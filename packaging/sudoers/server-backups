# Installed by the server-backups package. Each grant is a root-owned
# validating helper, never a raw binary with argument wildcards:
#   zfs-manual-snapshot (ADR-010): create/destroy backups-00/hosts/<host>@manual-*
#   raid-status         (ADR-011): two fixed read-only storcli queries
# Everything else tourbillon may sudo lives in /etc/sudoers.d/tourbillon
# (bin/bootstrap-kodiak-tourbillon.sh).
tourbillon ALL=(root) NOPASSWD: /usr/lib/server-backups/zfs-manual-snapshot
tourbillon ALL=(root) NOPASSWD: /usr/lib/server-backups/raid-status
