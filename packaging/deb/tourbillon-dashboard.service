[Unit]
Description=Tourbillon backup status dashboard
Documentation={{REPO_URL}}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tourbillon
Group=tourbillon
WorkingDirectory=/opt/server-backups/dashboard
# Optional (leading '-'): saratoga's TrueNAS API token, needed for the
# saratoga-replication panel. Same pattern as ~tourbillon/.config/tourbillon/env
# for github/bitbucket (ADR-004) — set up once, manually, not by postinst
# (which never has access to the token value). Absent this file, the
# dashboard degrades gracefully (tourbillon's own saratoga_replication_summary()
# already handles a missing token) rather than failing to start.
EnvironmentFile=-/var/lib/tourbillon/.config/saratoga/env
# Optional (leading '-'): DASHBOARD_PASSWORD_HASH + DASHBOARD_SECRET_KEY for
# the /config write routes (ADR-008). Same reasoning as the line above --
# set up once via bin/dashboard-set-password.sh, not by postinst. Absent
# this file, /config shows "no password set up yet" (auth.configured() is
# False) rather than failing to start; Phase 1's read-only routes are
# completely unaffected either way.
EnvironmentFile=-/var/lib/tourbillon/.config/dashboard/env
# GITHUB_TOKEN/BITBUCKET_TOKEN/etc (ADR-004), needed for the /config
# "Discover repos" write route (ADR-009), which shells out to
# `tourbillon repos discover` -- the same API-hitting command tourbillon's
# own cron already runs. NOT loaded via EnvironmentFile=: that file uses
# `export KEY=value` lines (required for its other use as a shell-sourced
# file, ". ~/.config/tourbillon/env && ..." in crontabs) -- systemd's
# EnvironmentFile parser does NOT accept the `export ` prefix and, worse,
# logs the full rejected line -- INCLUDING THE SECRET VALUE -- to the
# journal on every start. Confirmed the hard way, 2026-09-30. Sourcing it
# with a real shell instead (which understands `export` natively) avoids
# both problems; `|| true` keeps a missing file from failing the service.
ExecStart=/bin/bash -c 'source /var/lib/tourbillon/.config/tourbillon/env 2>/dev/null || true; exec /opt/server-backups/dashboard/.venv/bin/uvicorn api.main:app --host 192.168.1.61 --port 8000'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
# Drive-health panel needs smartctl's raw SATA ioctls (SMART attributes).
# Granting the capability directly (rather than sudo) keeps NoNewPrivileges
# intact -- ambient capabilities are set by systemd at process start, not
# gained via a setuid exec, so they aren't blocked by that flag. tourbillon
# also needs `disk` group membership to open /dev/sdb (mode 660, root:disk)
# in the first place -- see postinst.
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
